# level5.ad — variables de entorno. Copia este archivo a .env.local y rellénalo.
# Nunca se suben valores reales al repositorio (.env.local está en .gitignore).

# Supabase (W2)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Correo por SMTP propio (lib/mail.ts)
# SMTP_PORT: 465 (TLS implícito) o 587 (STARTTLS obligatorio)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# MAIL_FROM: "correo@level5.ad" o "Level Five <correo@level5.ad>"
MAIL_FROM=
# NOTIFY_EMAILS: direcciones separadas por comas; la primera es el Reply-To del acuse
NOTIFY_EMAILS=

# URL pública del sitio, para los enlaces de los correos (por defecto https://level5.ad)
SITE_URL=

# Sal del hash de IP para el límite de ritmo (W2)
RATE_LIMIT_SALT=
